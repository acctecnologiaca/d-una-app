<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_duna_sync_log_tree" model="ir.ui.view">
        <field name="name">duna.sync.log.tree</field>
        <field name="model">duna.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Historial de Sincronización D-Una" create="false" edit="false" delete="true"
                  decoration-success="status == 'success'" decoration-danger="status == 'error'">
                <field name="create_date" string="Fecha y Hora"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="status_code"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
            </tree>
        </field>
    </record>

    <record id="view_duna_sync_log_form" model="ir.ui.view">
        <field name="name">duna.sync.log.form</field>
        <field name="model">duna.sync.log</field>
        <field name="arch" type="xml">
            <form string="Detalle de Transmisión D-Una" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos del Evento">
                            <field name="create_date" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="status_code" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Respuesta del Servidor" name="response">
                            <field name="response_message" readonly="1"/>
                        </page>
                        <page string="Resumen del Payload Enviado" name="payload">
                            <field name="payload_summary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_duna_sync_log" model="ir.actions.act_window">
        <field name="name">Historial D-Una</field>
        <field name="res_model">duna.sync.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay transmisiones registradas aún.
            </p>
            <p>
                Cada vez que se modifique un producto, existencia o se ejecute una sincronización con D-Una, el resultado quedará registrado aquí.
            </p>
        </field>
    </record>
</odoo>
